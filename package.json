{
  "name": "x-bot",
  "description": "Twitter / X bot for responding to mentions with AI-generated answers.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Travis Fischer <travis@transitivebullsh.it>",
  "contributors": [
    "Riley Tomasek <riley@dexa.ai>",
    "Travis Fischer <travis@transitivebullsh.it>"
  ],
  "repository": {
    "type": "git",
    "url": "dexaai/xbot"
  },
  "packageManager": "pnpm@9.1.4",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "exec": "tsx bin/xbot.ts",
    "prepare": "husky install",
    "test": "run-s test:*",
    "test:format": "prettier --check \"**/*.{js,ts,tsx}\"",
    "test:lint": "eslint --cache --cache-location ./node_modules/.cache/eslint .",
    "test:typecheck": "tsc --noEmit",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@dexaai/dexter": "^4.0.1",
    "@keyv/redis": "^4.0.1",
    "@nangohq/node": "^0.45.0",
    "cleye": "^1.3.2",
    "delay": "^6.0.0",
    "dotenv-safe": "^9.1.0",
    "ioredis": "^5.4.1",
    "keyv": "^5.2.1",
    "ky": "^1.7.2",
    "ms": "^2.1.3",
    "nanoid": "^5.0.8",
    "openai": "^4.73.0",
    "openai-fetch": "^3.3.2",
    "p-map": "^7.0.2",
    "p-memoize": "^7.1.1",
    "p-throttle": "^6.2.0",
    "quick-lru": "^7.0.0",
    "random": "^5.1.1",
    "tiny-invariant": "^1.3.3",
    "twitter-api-sdk": "^1.2.1",
    "twitter-utils": "^0.4.1",
    "type-fest": "^4.35.0",
    "url-regex": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@dexaai/eslint-config": "^1.3.6",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/dotenv-safe": "^8.1.6",
    "@types/ms": "^0.7.34",
    "@types/node": "^22.9.1",
    "@types/twitter-text": "^3.1.10",
    "eslint": "^8.57.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --ignore-unknown --write"
    ]
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@dexaai/eslint-config",
      "@dexaai/eslint-config/node"
    ],
    "rules": {
      "no-console": "off",
      "import/order": "off",
      "no-process-env": "off",
      "no-use-before-define": "off",
      "import/consistent-type-specifier-style": "off"
    }
  }
}
